# Flood Agent settings.
#
# Generated from flood_agent/config.py and flood_agent/defaults.toml; regenerate with:
#   uv run python -m flood_agent.config > .env.example
#
# Copy to .env (already gitignored). The app reads .env from the working directory at
# startup. A variable already set in the real environment wins over the same variable in
# .env, and blank values count as unset.
#
# Only OPENROUTER_API_KEY needs a value. The other lines are commented out and show the
# default from defaults.toml; uncomment one only to change it, so a copied file doesn't
# pin defaults that may change later.

# OpenRouter API key. Needed to send a prompt to a real model (not No model); the only setting without a default. Never commit a real key.
OPENROUTER_API_KEY=

# The model preselected under the prompt box: an id from the curated [[models]] list in
# defaults.toml. The list (label, context window, Effort levels) is edited there, not here.
# DEFAULT_MODEL=z-ai/glm-5.3

# MODELS: the curated model list, the [[models]] tables in defaults.toml (not set from .env).

# Read-only flow records. Create with: uv run python -m flood_agent.generator data/telemetry.db
# TELEMETRY_DB=data/telemetry.db

# Writable database holding Result Tables.
# RESULTS_DB=data/results.db

# Conversations, messages, Displays and Traces.
# APP_DB=data/app.db

# Hand-authored Semantic Layer (the generator also writes window_start/window_end into it).
# SEMANTIC_LAYER=semantic_layer.yaml

# Result Tables are deleted this many hours after they are created.
# RESULT_TTL_HOURS=24

# A query running longer than this many seconds is aborted.
# QUERY_TIMEOUT_S=30

# A chart over a Result Table with more rows than this shows only its first rows.
# CHART_ROW_CAP=10000

# Failed run_query / run_count_query attempts allowed per user turn before the Agent gives up.
# MAX_FAILED_ATTEMPTS=3

# LLM calls allowed per user turn (a backstop against a model looping on tool calls).
# MAX_LLM_STEPS=10

# Address the web server listens on.
# HOST=127.0.0.1

# Port the web server listens on.
# PORT=8000

# The eval runner (python -m flood_agent.evalset)
# reads OPENROUTER_API_KEY and the telemetry_db and semantic_layer paths (overridable with
# --db and --semantic-layer) from this file or the environment, takes its model list from
# --models, and always uses the limits in defaults.toml so runs are comparable.
