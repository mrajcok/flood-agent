# Flood Defender settings.
#
# Generated from flood_defender/config.py and flood_defender/defaults.toml; regenerate with:
#   uv run python -m flood_defender.config > .env.example
#
# Copy to .env (already gitignored). The app reads .env from the working directory at
# startup. A variable already set in the real environment wins over the same variable in
# .env, and blank values count as unset.
#
# Only OPENROUTER_API_KEY needs a value. The other lines are commented out and show the
# default from defaults.toml; uncomment one only to change it, so a copied file doesn't
# pin defaults that may change later.

# openrouter calls a real model (needs OPENROUTER_API_KEY). fake is Fake Mode: a scripted
# stand-in answers Canned Prompts listed on the page, so no model is called and no key is needed.
# Try it for one run with: LLM_BACKEND=fake uv run python -m flood_defender
# LLM_BACKEND=openrouter

# OpenRouter API key. Required when LLM_BACKEND is openrouter; the only setting without a default. Never commit a real key.
OPENROUTER_API_KEY=

# Model used for chat.
# Cheaper open-weight models to try (confirm with the eval runner first):
# deepseek/deepseek-v4-pro-0813, z-ai/glm-5.3
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Read-only flow records. Create with: uv run python -m flood_defender.generator data/telemetry.db
# TELEMETRY_DB=data/telemetry.db

# Writable database holding Result Tables.
# RESULTS_DB=data/results.db

# Conversations, messages, Displays and Traces.
# Tip: use a separate database for Fake Mode, for example data/fake.db.
# APP_DB=data/app.db

# Hand-authored Semantic Layer (the generator also writes window_start/window_end into it).
# SEMANTIC_LAYER=semantic_layer.yaml

# Result Tables are deleted this many hours after their Conversation's last activity.
# RESULT_TTL_HOURS=24

# A query running longer than this many seconds is aborted.
# QUERY_TIMEOUT_S=30

# A query producing more rows than this is refused (the LLM is told to aggregate or filter).
# MAX_RESULT_ROWS=1000000

# A chart over a Result Table with more rows than this is refused.
# CHART_ROW_CAP=10000

# Failed run_query attempts allowed per user turn before the Agent gives up.
# MAX_FAILED_ATTEMPTS=3

# LLM calls allowed per user turn (a backstop against a model looping on tool calls).
# MAX_LLM_STEPS=10

# Address the web server listens on.
# HOST=127.0.0.1

# Port the web server listens on.
# PORT=8000

# The eval runner (python -m flood_defender.evalset)
# reads OPENROUTER_API_KEY and the telemetry_db and semantic_layer paths (overridable with
# --db and --semantic-layer) from this file or the environment, takes its model list from
# --models, and always uses the limits in defaults.toml so runs are comparable.
